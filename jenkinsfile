pipeline {
    agent any

    environment {
        IMAGE_NAME = 'ahoum-sessions-api'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Check Dependencies') {
    steps {
        bat '''
            "C:\\Users\\madha\\AppData\\Local\\Programs\\Python\\Python314\\python.exe" --version
            docker --version
            docker compose version
            trivy --version
            git --version
        '''
    }
}
        stage('Install Dependencies') {
    steps {
        bat '''
            python -m venv venv
            venv\\Scripts\\python -m pip install --upgrade pip
            venv\\Scripts\\python -m pip install -r requirements.txt
            venv\\Scripts\\python -m pip install -r requirements-dev.txt
        '''
    }
}

        stage('Run Tests') {
    steps {
        bat 'venv\\Scripts\\python -m pytest -v'
    }
}

        stage('Build Docker Image') {
            steps {
                bat '''
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                '''
            }
        }

        stage('Security Scan') {
            steps {
                bat '''
                    trivy image --severity HIGH,CRITICAL \
                    --exit-code 1 ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Deploy Locally') {
            steps {
                bat '''
                    docker compose up -d --build
                '''
            }
        }


        stage('Health Check') {
            steps {
                bat '''
                    sleep 10
                    curl --fail http://localhost:8000/health
                '''
            }
        }

        stage('Production Approval') {
            steps {
                input message: 'Approve production deployment?', ok: 'Approve'
            }
        }
    }

    post {
        always {
            bat 'docker compose ps || true'
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the stage logs.'
        }
    }
}